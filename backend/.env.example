# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/smartparking?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Server Port (Set automatically by cloud hosting platforms like Render/Railway)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# Frontend Application URL (for CORS control)
CLIENT_URL=https://your-frontend-domain.vercel.app
